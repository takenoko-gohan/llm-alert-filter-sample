{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "schedule": ["before 9am every weekday"],
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "matchFileNames": ["cdk/**"],
      "groupName": "cdk dependencies"
    },
    {
      "matchManagers": ["cargo"],
      "matchFileNames": ["lambda/**"],
      "groupName": "lambda dependencies"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    }
  ]
}
